CREATE TABLE employees (
    employee_id INT PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    job_id INT NULL,
    salary DECIMAL(8,2),
    FOREIGN KEY (job_id) REFERENCES jobs(JOB_ID)
    ON DELETE SET NULL
    ON UPDATE SET NULL
) ENGINE=InnoDB;
